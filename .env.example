# Copy to .env and fill in. These override config.toml.

# --- Transaction source: pick ONE ---
#
# A) GEYSER PLAN (what this deployment runs) — set GRPC_ENDPOINT +
#    GRPC_X_TOKEN. Sub-second detection.
#    Raze:      http://grpc.raze.bot:4512    <-- NOTE: plaintext http, port 4512
#    Triton:    https://<your>.rpcpool.com
#    QuickNode: https://<your>.solana-mainnet.quiknode.pro
#
#    The scheme matters. TLS is applied from the URL scheme, so an https:// on a
#    plaintext endpoint (or vice versa) fails as an opaque transport error that
#    says nothing about the cause.
#
# B) STANDARD RPC PLAN (no Geyser) — leave GRPC_ENDPOINT empty and set RPC_URL
#    below. volens uses WebSocket logsSubscribe. Detection is ~1.4-6s behind
#    (measured), because getTransaction cannot read below `confirmed`.
#
# gRPC is always preferred when set. WebSocket fallback is DISABLED in
# config.toml for this deployment — Raze's WebSocket rejects the API key (401),
# so falling back would mean running blind. Check before re-enabling:
#   cargo test -- --ignored live_ws_fallback_connects
GRPC_ENDPOINT=
GRPC_X_TOKEN=
GRPC_COMMITMENT=processed

# --- Telegram alerts (optional; setting the token auto-enables alerts) ---
# Create a bot with @BotFather, then get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Telegram commands (optional; must ALSO set commands_enabled = true) ---
# Who may run /status, /metrics, /halt. Comma-separated chat ids.
# Unlike the token above, this does NOT enable anything by itself — it says WHO
# may command the bot, not that commands should be accepted. Turn them on in
# config.toml ([alerts].commands_enabled), so remote control is never something
# you switch on by accident.
# /halt is a remote kill switch: anyone on this list can stop your trading.
TELEGRAM_AUTHORIZED_CHAT_IDS=

# --- RPC (REQUIRED — powers liquidity, mint safety, LP supply, market cap) ---
# Standard JSON-RPC endpoint. Single provider by design: no failover list.
#   Raze:  https://rpc.raze.bot/?api-key=<your-key>
#
# This is load-bearing even when gRPC is the transaction source. Every filter
# that reads chain state fails CLOSED, so an endpoint that quietly starts
# returning 429 does not look like an outage — it looks like "no pool ever
# qualifies", with detections still flowing. If that is the symptom, check here
# FIRST:
#   curl -s -X POST "$RPC_URL" -d '{"jsonrpc":"2.0","id":1,"method":"getHealth"}'
# A healthy endpoint answers {"result":"ok"}; an exhausted plan answers with
# non-JSON text, which surfaces in the logs as "error decoding response body".
RPC_URL=
# Minimum quote-side liquidity, in SOL for WSOL pairs / USDC for USDC pairs.
MIN_QUOTE_LIQUIDITY=5.0
# Only if your provider serves WebSocket on a different host/path than RPC_URL.
RPC_WS_URL=

# --- Logging ---
LOG_LEVEL=info
# RUST_LOG=volens=debug,warn
